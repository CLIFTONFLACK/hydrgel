{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/new", "destination": "/", "permanent": false },
    { "source": "/new/consumer", "destination": "/consumer", "permanent": false },
    { "source": "/new/corporate", "destination": "/corporate", "permanent": false },
    { "source": "/new/humanitarian", "destination": "/humanitarian", "permanent": false }
  ],
  "rewrites": [
    { "source": "/mockups", "destination": "/mockups/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
